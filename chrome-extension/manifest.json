{
  "manifest_version": 3,
  "name": "Sheet-Bot Remote Dispatcher",
  "version": "1.0.0",
  "description": "Dispatch single and bulk cold outreach emails directly to your Sheet-Bot GitHub Action workflow.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sheet-Bot Remote Dispatcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
